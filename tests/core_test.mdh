// Core language semantics. Run with: medha test tests/

fn add(a: int, b: int = 10) -> int => a + b

fn classify(n) {
  match n {
    0 -> "zero"
    1 | 2 | 3 -> "small"
    is string -> "text"
    x if x is int and x < 0 -> "negative"
    [first, ...rest] -> "list starting with {first} (+{rest.len()})"
    {kind: "point", x, y} -> "point {x},{y}"
    _ -> "big"
  }
}

test "arithmetic and precedence" {
  assert 1 + 2 * 3 == 7
  assert (1 + 2) * 3 == 9
  assert 2 ** 3 ** 2 == 512
  assert -2 ** 2 == -4
  assert 7 / 2 == 3.5
  assert 7 % 3 == 1
  assert 1 == 1.0
  assert true != 1
}

test "strings interpolate any expression" {
  let name = "Medha"
  let xs = [1, 2, 3]
  assert "hi {name}" == "hi Medha"
  assert "sum {xs.sum() + 1}" == "sum 7"
  assert "literal \{braces\}" == "literal " + "\{" + "braces" + "\}"
  assert "nested {"inner {name}"}" == "nested inner Medha"
  assert r"raw {name}\n".len() == 12
  let block = """
    line one
      indented {name}
    """
  assert block == "line one\n  indented Medha"
}

test "let is immutable, var is not" {
  var count = 0
  count += 5
  count = count * 2
  assert count == 10
  let e = assert_throws(() => add("x"), "TypeError")
  assert e.message.contains("expected int")
}

test "functions: defaults, named arguments, closures, recursion" {
  assert add(1) == 11
  assert add(1, 2) == 3
  assert add(b: 1, a: 5) == 6
  let make_counter = fn() {
    var n = 0
    fn() { n += 1; n }
  }
  let next = make_counter()
  next()
  assert next() == 2
  fn fact(n) { if n <= 1 { 1 } else { n * fact(n - 1) } }
  assert fact(10) == 3628800
}

test "return type annotations are enforced" {
  fn bad() -> int { "nope" }
  assert_throws(bad, "TypeError")
}

test "if and match are expressions" {
  let size = if 3 > 2 { "yes" } else { "no" }
  assert size == "yes"
  assert classify(0) == "zero"
  assert classify(2) == "small"
  assert classify(-4) == "negative"
  assert classify("hey") == "text"
  assert classify([9, 8, 7]) == "list starting with 9 (+2)"
  assert classify({kind: "point", x: 1, y: 2}) == "point 1,2"
  assert classify(99) == "big"
  assert_throws(() => match 5 { 1 -> "one" }, "MatchError")
}

test "loops, break and continue" {
  var total = 0
  for i in 0..10 {
    if i % 2 == 0 { continue }
    if i > 7 { break }
    total += i
  }
  assert total == 16
  var n = 0
  while true { n += 1; if n == 5 { break } }
  assert n == 5
  var keys = []
  for k, v in {a: 1, b: 2} { keys.push("{k}={v}") }
  assert keys == ["a=1", "b=2"]
}

test "lists" {
  let xs = [5, 3, 8, 1]
  assert xs.sort() == [1, 3, 5, 8]
  assert xs.sort(desc: true).first() == 8
  assert xs.map(x => x * 2).filter(x => x > 5) == [10, 6, 16]
  assert xs.reduce((a, b) => a + b, 0) == 17
  assert xs[0] == 5 and xs[-1] == 1
  assert xs[1:3] == [3, 8]
  assert [...xs, 0].len() == 5
  assert [1, [2, 3], 4].flat() == [1, 2, 3, 4]
  assert [1, 2, 2, 3].unique() == [1, 2, 3]
  assert ["a", "b"].zip([1, 2]) == [["a", 1], ["b", 2]]
  assert [1, 2, 3, 4, 5].chunk(2) == [[1, 2], [3, 4], [5]]
  assert ["x", "y"].join(", ") == "x, y"
  assert 3 in xs and 4 not in xs
  assert_throws(() => xs[10], "IndexError")
}

test "records" {
  var user = {name: "Asha", age: 30}
  user.age += 1
  user["city"] = "Pune"
  assert user.keys() == ["name", "age", "city"]
  assert user.age == 31
  assert user?.missing == null
  assert (user?.nickname ?? "none") == "none"
  let name = "Asha"
  assert {name, tags: []} == {name: "Asha", tags: []}
  assert {...user, age: 1}.age == 1
  assert user.merge({x: 1}).has("x")
  assert_throws(() => user.nope, "FieldError")
}

test "pipelines and uniform call syntax" {
  fn double(x) => x * 2
  assert (4 |> double) == 8
  assert ([1, 2, 3] |> map(double) |> sum()) == 12
  assert 5.double() == 10
  assert map([1, 2], double) == [2, 4]
  assert ("a,b" |> split(",") |> len()) == 2
}

test "errors are records you can catch and rethrow" {
  var seen = ""
  try {
    throw error("NotFound", "no such user", id: 7)
  } catch e {
    seen = "{e.kind}:{e.message}:{e.id}"
  }
  assert seen == "NotFound:no such user:7"
  var cleaned = false
  try { try { throw "plain" } finally { cleaned = true } } catch e { assert e.kind == "Error" }
  assert cleaned
  let e = assert_throws(() => 1 / 0)
  assert e.kind == "MathError"
}

test "destructuring" {
  let {a, b: {c}} = {a: 1, b: {c: 2}}
  let [head, ...tail] = [1, 2, 3]
  assert a + c == 3
  assert head == 1 and tail == [2, 3]
}

test "null handling" {
  let u = null
  assert u?.name == null
  assert (u ?? "fallback") == "fallback"
  assert (null ?? null ?? 3) == 3
}
