{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Medha",
  "scopeName": "source.medha",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.medha", "match": "///.*$" },
        { "name": "comment.line.double-slash.medha", "match": "//.*$" },
        { "name": "comment.block.medha", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.raw.medha", "begin": "r\"", "end": "\"" },
        {
          "name": "string.quoted.triple.medha",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.double.medha",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escapes" }, { "include": "#interpolation" }]
        }
      ]
    },
    "escapes": { "name": "constant.character.escape.medha", "match": "\\\\." },
    "interpolation": {
      "name": "meta.interpolation.medha",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.medha" } },
      "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.medha" } },
      "patterns": [{ "include": "$self" }]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn|prompt|agent)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.function.medha" }, "2": { "name": "entity.name.function.medha" } }
        },
        {
          "match": "^\\s*(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.medha" }, "2": { "name": "entity.name.type.medha" } }
        },
        {
          "match": "^\\s*(model)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?==)",
          "captures": { "1": { "name": "storage.type.medha" }, "2": { "name": "variable.other.constant.medha" } }
        },
        {
          "match": "^\\s*(test)\\s+(?=\")",
          "captures": { "1": { "name": "keyword.control.medha" } }
        },
        {
          "match": "^\\s*(mock)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=->)",
          "captures": { "1": { "name": "keyword.control.medha" }, "2": { "name": "entity.name.function.medha" } }
        },
        {
          "match": "^\\s*(system|user|assistant|example|tools|max_steps)\\s+(?![=.(])",
          "captures": { "1": { "name": "keyword.other.directive.medha" } }
        },
        { "match": "^\\s*(budget)\\s*(?=\\()", "captures": { "1": { "name": "keyword.control.medha" } } }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.medha",
          "match": "\\b(if|else|while|for|in|match|return|break|continue|try|catch|finally|throw|assert|import|as|is)\\b"
        },
        { "name": "storage.type.medha", "match": "\\b(let|var|fn)\\b" },
        { "name": "keyword.other.medha", "match": "\\b(using|with|where)\\b" },
        { "name": "keyword.operator.word.medha", "match": "\\b(and|or|not)\\b" },
        { "name": "variable.language.medha", "match": "\\bit\\b" }
      ]
    },
    "constants": { "name": "constant.language.medha", "match": "\\b(true|false|null)\\b" },
    "numbers": { "name": "constant.numeric.medha", "match": "\\b\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?\\b" },
    "types": {
      "patterns": [
        { "name": "support.type.primitive.medha", "match": "\\b(string|int|float|bool|any|number|map)\\b" },
        { "name": "entity.name.type.medha", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.medha" } }
    },
    "operators": {
      "name": "keyword.operator.medha",
      "match": "\\|>|->|=>|\\?\\?|\\?\\.|\\.\\.\\.|\\.\\.|==|!=|<=|>=|\\*\\*|[+\\-*/%<>=|?]"
    }
  }
}
